<style>
.backend-visual {
  position: relative;
  width: 100%;
  max-width: 700px;
  margin-inline: auto;
  overflow: hidden;
}

.backend-visual svg {
  display: block;
  width: 100%;
  height: auto;
}

.backend-visual .network-lines {
  animation: network-pulse 5s ease-in-out infinite alternate;
}

.backend-visual .data-packets circle {
  filter: drop-shadow(0 0 5px #fff);
}

.backend-visual .core-cube {
  transform-box: fill-box;
  transform-origin: center;
  animation: core-breathe 5s ease-in-out infinite;
}

.backend-visual .tech-labels {
  animation: labels-in 1.5s ease-out both;
}

.backend-visual .scan-ring {
  transform-box: fill-box;
  transform-origin: center;
  animation: scan-rotate 35s linear infinite;
}

.backend-visual .network-nodes circle {
  animation: node-pulse 2.5s ease-in-out infinite alternate;
}

@keyframes network-pulse {
  from { opacity: .25; }
  to { opacity: .8; }
}

@keyframes core-breathe {
  0%, 100% { opacity: .8; }
  50% { opacity: 1; }
}

@keyframes labels-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scan-rotate {
  to { transform: rotate(360deg); }
}

@keyframes node-pulse {
  from { opacity: .35; }
  to { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .backend-visual *,
  .backend-visual *::before,
  .backend-visual *::after {
    animation: none !important;
  }
}
</style>
